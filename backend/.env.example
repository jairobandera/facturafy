# Copia este archivo a ".env" y ajusta los valores.

# ---- Servidor ----
PORT=8080
# Ruta base de la API (se mantiene igual que el original para compatibilidad)
API_BASE=/Stockify/api/v1
# Origen permitido para CORS (frontend). Usa * para permitir cualquiera en desarrollo.
CORS_ORIGIN=*

# ---- Base de datos MySQL / MariaDB ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=facturafy

# ---- Seguridad (JWT) ----
# Clave de firma del token. Cambiala en produccion.
JWT_SECRET=@TI2025
# Duracion del token en horas
JWT_EXPIRATION_HOURS=10

# ---- Frontend estatico ----
# Si es "true", el backend tambien sirve la carpeta ../frontend
SERVE_FRONTEND=true

# ---- Factura electronica Uruguay (DGI/CFE) ----
# Apagado por defecto: las ventas se registran internamente (estado INTERNO).
# Para emitir CFE reales, poner CFE_ENABLED=true, cargar las credenciales del
# proveedor e implementar el envio en src/modules/facturacion/cfe.js.
CFE_ENABLED=false
CFE_PROVIDER=
CFE_API_URL=
CFE_API_KEY=
CFE_RUT_EMISOR=
CFE_CERT_PATH=

# ---- Envio de correo (SMTP) ----
# Se usa para mandar a los clientes el estado de cuenta de la quincena. Si SMTP_HOST
# queda vacio, el envio queda deshabilitado y la API avisa que no esta configurado.
# Ejemplo Gmail: host smtp.gmail.com, port 465, secure true, user y pass (app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que ven los clientes (si se omite, se usa SMTP_USER).
SMTP_FROM=
