# Copia este archivo a ".env" y ajusta los valores.

# ---- Servidor ----
PORT=8080
# Ruta base de la API (se mantiene igual que el original para compatibilidad)
API_BASE=/Stockify/api/v1
# Origen permitido para CORS (frontend). Usa * para permitir cualquiera en desarrollo.
CORS_ORIGIN=*

# ---- Base de datos MySQL / MariaDB ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=stockify

# ---- Seguridad (JWT) ----
# Clave de firma del token. Cambiala en produccion.
JWT_SECRET=@TI2025
# Duracion del token en horas
JWT_EXPIRATION_HOURS=10

# ---- Frontend estatico ----
# Si es "true", el backend tambien sirve la carpeta ../frontend
SERVE_FRONTEND=true
